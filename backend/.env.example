# Copy to .env and adjust as needed. All settings are prefixed with LIFEOS_.

# SQLAlchemy database URL. Default is a local SQLite file under ./data.
LIFEOS_DATABASE_URL=sqlite:///data/lifeos.db

# Path to your Obsidian vault (used from M2 onwards).
LIFEOS_VAULT_PATH=/Users/scarl/Documents/AI-Vault

# Daily brief auto-generation time (local, HH:MM).
LIFEOS_BRIEF_TIME=07:00

# Subfolder under the vault for daily notes.
LIFEOS_DAILY_NOTES_SUBDIR=Daily Notes

# Subfolder under the vault for weekly reviews.
LIFEOS_WEEKLY_REVIEWS_SUBDIR=Reviews

# Weekly review auto-generation (day name + local time).
LIFEOS_REVIEW_DAY=sun
LIFEOS_REVIEW_TIME=18:00

# API server (for web UI).
LIFEOS_API_HOST=127.0.0.1
LIFEOS_API_PORT=8000
LIFEOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Optional LLM (narration only — engine stays deterministic).
# LIFEOS_LLM_PROVIDER=openai
# LIFEOS_LLM_API_KEY=
# LIFEOS_LLM_MODEL=

# Echo SQL statements (debugging).
LIFEOS_ECHO_SQL=false
