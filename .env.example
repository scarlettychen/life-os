# Copy to .env and adjust as needed. All settings are prefixed with LIFEOS_.

# SQLAlchemy database URL. Default is a local SQLite file under ./data.
LIFEOS_DATABASE_URL=sqlite:///data/lifeos.db

# Path to your Obsidian vault (used from M2 onwards).
# LIFEOS_VAULT_PATH=/Users/scarl/Documents/AI-Vault

# Echo SQL statements (debugging).
LIFEOS_ECHO_SQL=false
